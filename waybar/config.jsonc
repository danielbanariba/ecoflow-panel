// Paste into your waybar config and add "custom/ecoflow" to a modules list.
{
  "custom/ecoflow": {
    "exec": "$HOME/.local/bin/ecoflow-waybar",
    // The client caches for 60 s, so a shorter interval costs nothing but adds
    // nothing either.
    "interval": 120,
    "return-type": "json",
    "format": "{icon} {}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true
  }
}
