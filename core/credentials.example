# EcoFlow IoT Developer Platform credentials.
#   https://developer.ecoflow.com  ->  Security Information Management
#
# These grant CONTROL of the unit, not just reads. The installer puts this at
# mode 0600; keep it that way and never paste the values where they can be
# logged.
ACCESS_KEY=
SECRET_KEY=
# Filled in by `ecoflow-battery --discover`
DEVICE_SN=
