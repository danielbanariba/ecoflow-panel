#!/usr/bin/env python3
"""Alert when mains power drops and the EcoFlow takes over, and when it returns.

Grid presence is read from inv.acInVol, the AC input voltage in millivolts:
roughly 115000 while the wall is live, 0 once it is not. inv.inputWatts is
carried in the message but is not the test — it also reads 0 when the pack is
simply full and has stopped drawing.

Only transitions are announced, so a sustained outage does not repeat every
tick, and the first run stays silent rather than announcing whatever state it
happens to find.

Every default run (not --dry-run, --status or --log) also stores one raw
sample in samples.db, next to the outage log -- see README for the schema.
Recording is best effort: a failure there is reported on stderr and can
never block the alert above.

  --dry-run   evaluate and report, send nothing
  --status    print the current reading and exit
  --log       print the outage history and the total time without mains
"""
import json, os, sqlite3, subprocess, sys, time, urllib.request
from datetime import datetime

STATE = os.path.expanduser("~/.cache/ecoflow-power-watch.json")
# The cache can be wiped; the log is history, so it lives in share/ not cache/.
LOG = os.path.expanduser("~/.local/share/ecoflow/outages.log")
SAMPLES_DB = os.path.expanduser("~/.local/share/ecoflow/samples.db")
HELPER = os.path.expanduser("~/.local/bin/ecoflow-battery")
NTFY_HOST = "https://ntfy.sh"
# Below this the wall is considered dead. Real brownouts sit far above it, and
# a disconnected input reads a clean 0, so the gap is wide on purpose.
VOLT_FLOOR = 50_000


def ntfy_topic():
    try:
        out = subprocess.run(
            ["dconf", "read", "/org/gnome/shell/extensions/brainusage/ntfy-topic"],
            capture_output=True, text=True, timeout=5).stdout.strip()
        return out.strip("'") or None
    except Exception:
        return None


def num(d, *keys):
    """First key that carries a real number, or None. `or 0` cannot be used
    here: it maps a missing key onto a legitimate reading of zero."""
    for k in keys:
        v = d.get(k)
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            return float(v)
    return None


def pick_soc(d):
    """ems.lcdShowSoc is what the unit prints on its own screen, so prefer it
    over the raw BMS figures, which drift a percent or two from the display."""
    v = num(d, "ems.lcdShowSoc", "bmsMaster.soc", "bms_bmsStatus.soc", "pd.soc", "soc")
    return round(v) if v is not None else None


# Schema v1 (see README): column -> (num() keys, transform on the raw value,
# SQL column type). `soc` is not listed here: it comes from pick_soc(), which
# walks a fallback chain rather than a plain num() lookup.
SAMPLE_FIELDS = (
    ("grid_v",         ("inv.acInVol",),           (lambda v: v / 1000.0), "REAL"),
    ("grid_hz",        ("inv.acInFreq",),          None,                    "REAL"),
    ("ac_in_w",        ("inv.inputWatts",),        None,                    "REAL"),
    ("ac_out_w",       ("inv.outputWatts",),       None,                    "REAL"),
    ("in_w",           ("pd.wattsInSum",),         None,                    "REAL"),
    ("out_w",          ("pd.wattsOutSum",),        None,                    "REAL"),
    ("solar_in_w",     ("mppt.inWatts",),          None,                    "REAL"),
    ("batt_in_w",      ("bmsMaster.inputWatts",),  None,                    "REAL"),
    ("batt_out_w",     ("bmsMaster.outputWatts",), None,                    "REAL"),
    ("batt_temp_c",    ("bmsMaster.temp",),        None,                    "REAL"),
    ("chg_ac_wh",      ("pd.chgPowerAc",),         None,                    "REAL"),
    ("chg_dc_wh",      ("pd.chgPowerDc",),         None,                    "REAL"),
    ("chg_solar_wh",   ("pd.chgSunPower",),        None,                    "REAL"),
    ("dsg_ac_wh",      ("pd.dsgPowerAc",),         None,                    "REAL"),
    ("dsg_dc_wh",      ("pd.dsgPowerDc",),         None,                    "REAL"),
    ("cycles",         ("bmsMaster.cycles",),      None,                    "INTEGER"),
    ("soh",            ("bmsMaster.soh",),         None,                    "REAL"),
    ("chg_remain_min", ("ems.chgRemainTime",),     None,                    "INTEGER"),
    ("dsg_remain_min", ("ems.dsgRemainTime",),     None,                    "INTEGER"),
)

_SAMPLE_COLUMNS = ("ts", "soc") + tuple(column for column, *_ in SAMPLE_FIELDS)
_CREATE_TABLE_SQL = "CREATE TABLE IF NOT EXISTS samples ({})".format(", ".join(
    ["ts INTEGER PRIMARY KEY", "soc INTEGER"]
    + [f"{column} {sqltype}" for column, _, _, sqltype in SAMPLE_FIELDS]
))
_INSERT_SQL = "INSERT OR IGNORE INTO samples ({}) VALUES ({})".format(
    ", ".join(_SAMPLE_COLUMNS), ", ".join("?" for _ in _SAMPLE_COLUMNS))


def sample_row(d, ts):
    """Map one already-fetched payload onto schema v1: a dict ready for
    INSERT, keyed by column name plus "ts". A source key that is missing or
    not a real number becomes NULL -- never 0, which would read back as a
    real measurement (see num()'s docstring)."""
    row = {"ts": ts, "soc": pick_soc(d)}
    for column, keys, transform, _sqltype in SAMPLE_FIELDS:
        v = num(d, *keys)
        row[column] = v if v is None or transform is None else transform(v)
    return row


def record_sample(d, ts):
    """Insert one row for this run's payload into the sample history.
    Best effort and isolated: any failure (a locked file, a full disk, a
    directory that cannot be created) is reported on stderr and swallowed,
    so recording can never block the outage alert, the state update, or the
    exit status."""
    try:
        row = sample_row(d, ts)
        os.makedirs(os.path.dirname(SAMPLES_DB), exist_ok=True)
        conn = sqlite3.connect(SAMPLES_DB)
        try:
            existed = conn.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' AND name='samples'"
            ).fetchone() is not None
            conn.execute(_CREATE_TABLE_SQL)
            conn.execute("PRAGMA journal_mode=WAL")
            if not existed:
                conn.execute("PRAGMA user_version = 1")
            conn.execute(_INSERT_SQL, [row[c] for c in _SAMPLE_COLUMNS])
            conn.commit()
        finally:
            conn.close()
    except Exception as e:
        print(f"ecoflow-power-watch: could not record sample: {e}", file=sys.stderr)


def fetch_payload():
    """Run the helper once and parse its JSON. None if the call failed,
    timed out, or the output was not a JSON object. The one seam that tests
    stub so no real API call is ever made."""
    try:
        out = subprocess.run([HELPER, "--json", "--force"],
                             capture_output=True, text=True, timeout=30)
        if out.returncode != 0:
            return None
        d = json.loads(out.stdout)
        return d if isinstance(d, dict) else None
    except Exception:
        return None


def reading(d):
    """Build the outage-decision reading from an already-fetched payload.
    None if there is no payload, or if it lacks either of the two figures
    the decision rests on: mains voltage and charge. If either is absent the
    payload is partial, and guessing produces a blackout that never happened
    -- refuse to judge instead."""
    if d is None:
        return None
    volts = num(d, "inv.acInVol")
    soc = pick_soc(d)
    if volts is None or soc is None:
        return None
    return {
        "volts": volts / 1000.0,
        "in_watts": num(d, "inv.inputWatts") or 0.0,
        "out_watts": num(d, "inv.outputWatts", "bmsMaster.outputWatts") or 0.0,
        "soc": soc,
        "dsg_min": int(num(d, "ems.dsgRemainTime") or 0),
    }


def push(title, body, topic, tags, priority):
    if topic:
        try:
            req = urllib.request.Request(
                f"{NTFY_HOST}/{topic}", data=body.encode(),
                headers={"Title": title, "Priority": priority, "Tags": tags})
            urllib.request.urlopen(req, timeout=10).read()
        except Exception as e:
            print(f"ntfy failed: {e}", file=sys.stderr)
    subprocess.run(["notify-send", "-a", "EcoFlow", "-i", "battery",
                    "-u", "critical", title, body], check=False)


def log_event(kind, soc, minutes=None):
    """Append one line per transition. Tab-separated so it stays greppable and
    still opens cleanly in a spreadsheet."""
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        dur = "" if minutes is None else str(minutes)
        with open(LOG, "a") as fh:
            fh.write(f"{stamp}\t{kind}\t{soc}\t{dur}\n")
    except OSError:
        pass


def human(mins):
    if mins is None:
        return None
    if mins <= 0:
        return "menos de 1 min"
    return f"{mins // 60} h {mins % 60} min" if mins >= 60 else f"{mins} min"


def outage_minutes(now):
    """Minutes since the last logged outage, or None if there is no open one."""
    try:
        with open(LOG) as fh:
            lines = [l.rstrip("\n") for l in fh if l.strip()]
    except OSError:
        return None
    for line in reversed(lines):
        parts = line.split("\t")
        if len(parts) >= 2 and parts[1] == "corte":
            try:
                started = datetime.strptime(parts[0], "%Y-%m-%d %H:%M:%S")
                return max(0, int((now - started).total_seconds() // 60))
            except ValueError:
                return None
        if len(parts) >= 2 and parts[1] == "retorno":
            return None            # the previous outage already closed
    return None


def show_log():
    try:
        with open(LOG) as fh:
            lines = [l.rstrip("\n") for l in fh if l.strip()]
    except OSError:
        print("sin registro todavía")
        return 0
    total = 0
    print(f"  {'fecha y hora':<21} {'evento':<8} {'batería':>7}  duración")
    for line in lines:
        p = (line.split("\t") + ["", "", "", ""])[:4]
        dur = f"{human(int(p[3]))}" if p[3].isdigit() else ""
        if p[3].isdigit():
            total += int(p[3])
        print(f"  {p[0]:<21} {p[1]:<8} {p[2]+'%':>7}  {dur}")
    cortes = sum(1 for l in lines if "\tcorte\t" in l)
    print(f"\n  {cortes} corte(s), {human(total) if total else '0 min'} sin red en total")
    return 0


def main():
    args = sys.argv[1:]
    if "--log" in args:
        return show_log()

    d = fetch_payload()
    ts = int(time.time())
    # Record whatever payload was obtained before the partial-payload bail-out
    # below can discard it -- a partial reading still becomes a row with NULLs
    # in the missing columns, not a lost minute. Only the default (timer) path
    # writes to disk.
    if d is not None and "--dry-run" not in args and "--status" not in args:
        record_sample(d, ts)

    r = reading(d)
    if not r:
        print("no reading", file=sys.stderr)
        return 1

    live = r["volts"] > VOLT_FLOOR / 1000.0

    if "--status" in args:
        print(f"red: {'presente' if live else 'AUSENTE'}  {r['volts']:.1f} V  "
              f"entrada {r['in_watts']:.0f} W  bateria {r['soc']}%")
        return 0

    try:
        with open(STATE) as fh:
            prev = json.load(fh).get("live")
    except (OSError, ValueError):
        prev = None

    topic = ntfy_topic()
    if prev is not None and prev != live:
        now = datetime.now()
        stamp = now.strftime("%H:%M")
        if not live:
            title = "Se fue la luz"
            body = f"{stamp} · batería {r['soc']}%"
            if r["dsg_min"] > 0:
                body += f" · autonomía {human(r['dsg_min'])}"
            # high, not urgent: ntfy's top priority buzzes the phone with a long,
            # insistent pattern. This matches the usage alert's vibration.
            tags, prio = "electric_plug,warning", "high"
            if "--dry-run" not in args:
                log_event("corte", r["soc"])
        else:
            title = "Volvió la luz"
            body = f"{stamp} · batería {r['soc']}%"
            # How long it lasted is the number worth keeping, and it can only be
            # worked out here, against the timestamp the outage was logged with.
            mins = outage_minutes(now)
            if mins is not None:
                body += f" · duró {human(mins)}"
            tags, prio = "electric_plug,white_check_mark", "default"
            if "--dry-run" not in args:
                log_event("retorno", r["soc"], mins)

        if "--dry-run" in args:
            print(f"WOULD SEND -> {title}: {body}")
        else:
            push(title, body, topic, tags, prio)
        print(f"transicion: {'red -> bateria' if not live else 'bateria -> red'}")
    else:
        print(f"sin cambio: red {'presente' if live else 'ausente'} "
              f"({r['volts']:.1f} V, bateria {r['soc']}%)"
              + ("" if prev is not None else " [primera corrida, no avisa]"))

    if "--dry-run" not in args:
        try:
            os.makedirs(os.path.dirname(STATE), exist_ok=True)
            with open(STATE, "w") as fh:
                json.dump({"live": live}, fh)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
